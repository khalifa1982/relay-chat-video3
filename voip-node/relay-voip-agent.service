# RELAY mediasoup media node.
#
# Install to /etc/systemd/system/relay-voip-agent.service on a MEDIA node (never on an app
# instance — see ../voip-node/README.md for why they are separate machines).
#
# THE UNIT NAME, THE PATHS AND THE USER ARE NOT OURS TO CHOOSE.
#
# Infra provisions each media node with this unit ALREADY INSTALLED AND ENABLED, held dormant
# by `ConditionPathExists`. So every one of these values is a contract with a machine that
# already exists:
#
#     unit      relay-voip-agent.service       (enabled at provision time)
#     entry     /opt/relay-voip/agent/index.js
#     env       /etc/relay-voip/agent.env
#     user      relayvoip
#
# Getting any of them wrong fails SILENTLY rather than loudly: a wrong entrypoint path leaves
# `ConditionPathExists` unsatisfied, which systemd reports as a clean "condition failed" and
# the unit sits inactive forever — indistinguishable from a node nobody has started yet. That
# is why this file is a checked-in artifact the deploy overwrites, rather than something each
# node keeps its own copy of and quietly diverges on.
#
# TWO THINGS HERE ARE LOAD-BEARING RATHER THAN BOILERPLATE:
#
#  1. `Restart=always` with a short backoff. The agent deliberately EXITS when a mediasoup
#     worker dies (`worker.on("died") → process.exit(1)`) instead of limping on with a
#     worker short. A dead worker means its routers are gone, so the rooms pinned to them
#     cannot be renegotiated — the honest move is to go away, let the registry TTL expire
#     (15s) so the app stops assigning rooms here, and let clients take the rejoin path
#     they already have. A process that stayed up would keep advertising capacity it does
#     not have, which is the failure nobody can diagnose.
#
#  2. NO `PrivateNetwork`, and NO port hardening beyond what the SG already does. The whole
#     point of a media node is that 40000–49999/udp reaches this host directly. Anything
#     that puts a translation layer between the kernel and those ports breaks ICE.
#
# It does NOT run as root: media needs high ports, not privileged ones.

[Unit]
Description=RELAY VoIP SFU node agent (mediasoup)
Documentation=https://github.com/khalifa1982/relay-chat-video3/blob/main/voip-node/README.md
After=network-online.target
Wants=network-online.target

# Dormant until the agent is actually installed. This is what lets the unit ship ENABLED on a
# freshly provisioned node: it starts itself the moment the entrypoint appears, and a reboot
# before then is a no-op rather than a crash loop.
ConditionPathExists=/opt/relay-voip/agent/index.js

# A crash loop must not hammer Redis or mask a real fault as "it keeps coming back".
# These are [Unit] options. They sat in [Service] until v2.106.72, where systemd ignores them
# outright — so this backstop had never actually been in force.
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=relayvoip
Group=relayvoip
WorkingDirectory=/opt/relay-voip/agent

# The secrets live here, not in this unit and not in the repo:
#   VOIP_NODE_SECRET   REQUIRED — HMAC key for the signaling→node API. The agent refuses to
#                      start without it, because an unsigned internal API is reachable by
#                      anything with VPC access to port 4443.
#   REDIS_URL          the same ElastiCache URL the app fleet uses
# Optional: VOIP_API_PORT (4443), RTC_MIN_PORT (40000), RTC_MAX_PORT (49999)
EnvironmentFile=/etc/relay-voip/agent.env

ExecStart=/usr/bin/node /opt/relay-voip/agent/index.js

# SIGTERM is handled: the agent deregisters from the registry before exiting, so a planned
# restart takes the node out of rotation immediately instead of waiting out the TTL.
KillSignal=SIGTERM
TimeoutStopSec=15

Restart=always
RestartSec=2s

# mediasoup runs one C++ worker per core plus the Node process; the default file limit is
# not enough once a node is holding several rooms' worth of transports.
LimitNOFILE=262144

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=relay-voip-agent

[Install]
WantedBy=multi-user.target
